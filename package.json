{
  "name": "reelmaster",
  "version": "1.0.0",
  "description": "ReelMaster phase 0 render engine",
  "main": "index.js",
  "scripts": {
    "prepare:presenter": "node --import ./scripts/local-only.mjs --import tsx scripts/prepare-presenter.ts",
    "production:resolve-visuals": "node --import ./scripts/local-only.mjs --import tsx scripts/resolve-visuals.ts",
    "demo:graphics": "node --import ./scripts/local-only.mjs --import tsx scripts/demo-graphics.ts",
    "demo:visual": "node --import ./scripts/local-only.mjs --import tsx scripts/demo-visual.ts",
    "production:assets": "node --import ./scripts/local-only.mjs --import tsx scripts/visual-assets.ts list",
    "production:assign-asset": "node --import ./scripts/local-only.mjs --import tsx scripts/visual-assets.ts assign",
    "production:status": "node --import ./scripts/local-only.mjs --import tsx scripts/visual-assets.ts status",
    "prepare:production": "node --import ./scripts/local-only.mjs --import tsx scripts/production.ts prepare",
    "inspect:narration": "node --import ./scripts/local-only.mjs --import tsx scripts/production.ts inspect",
    "import:narration": "node --import ./scripts/local-only.mjs --import tsx scripts/production.ts import",
    "render:production": "node --import ./scripts/local-only.mjs --import tsx scripts/render-production.ts",
    "generate:reel": "node --import ./scripts/local-only.mjs --import tsx scripts/generate-reel.ts",
    "test:integration:text": "node --import ./scripts/local-only.mjs --import tsx scripts/integration-text.ts",
    "test": "node --import ./scripts/local-only.mjs --import ./scripts/test-environment.mjs --import tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audio": "tsx scripts/audio.ts",
    "discover": "node --import ./scripts/local-only.mjs --import tsx scripts/render.ts --discover",
    "render": "node --import ./scripts/local-only.mjs --import tsx scripts/render.ts",
    "prepare:marcos": "node --import ./scripts/local-only.mjs --import tsx scripts/prepare-marcos.ts",
    "render:baseline": "tsx scripts/render-baseline.ts",
    "studio": "remotion studio src/composition/index.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "snapshot": "tsx scripts/prepare.ts",
    "build:renderer": "npm run snapshot && tsx scripts/build-renderer.ts",
    "test:integration:image": "node --import ./scripts/local-only.mjs --import tsx scripts/integration-image.ts",
    "demo:images": "node --import ./scripts/local-only.mjs --import tsx scripts/demo-images.ts",
    "quality:images": "node --import ./scripts/local-only.mjs --import tsx scripts/quality-images.ts",
    "demo:quality": "node --import ./scripts/local-only.mjs --import tsx scripts/demo-quality.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@remotion/bundler": "4.0.523",
    "@remotion/cli": "4.0.523",
    "@remotion/renderer": "4.0.523",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.523",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.19.x"
  }
}
